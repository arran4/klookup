{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KLookup Provider Package Manifest",
  "description": "Schema for provider.json package manifests in providers.d/",
  "type": "object",
  "required": ["id", "name", "version", "runtime", "entry"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "runtime": {
      "type": "string",
      "enum": ["javascript", "native", "process"]
    },
    "entry": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secrets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "pagination": { "type": "boolean" },
        "details": { "type": "boolean" },
        "separateContent": { "type": "boolean" },
        "hierarchy": { "type": "boolean" },
        "authentication": { "type": "boolean" },
        "authType": { "type": "string" }
      }
    },
    "defaultSettings": { "type": "object" }
  }
}
