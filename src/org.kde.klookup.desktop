[Desktop Entry]
Name=KLookup
GenericName=Multi-Provider Search Tool
Comment=Dictionary-style multi-provider search tool for KDE
Exec=klookup %u
Icon=org.kde.klookup
Type=Application
Categories=Qt;KDE;Utility;Dictionary;
Terminal=false
StartupNotify=true
# The application implements a custom D-Bus search adaptor, not
# org.freedesktop.Application at /org/kde/klookup. Launch through Exec;
# KDBusService::Unique still handles subsequent invocations.
DBusActivatable=false

Actions=show-search;search-clipboard;

[Desktop Action show-search]
Name=Show/focus KLookup search
Exec=klookup --show-search
Icon=edit-find

[Desktop Action search-clipboard]
Name=Search clipboard now
Exec=klookup --search-clipboard
Icon=edit-paste
