[Desktop Entry]
Name=KLookup
GenericName=Multi-Provider Search Tool
Comment=Dictionary-style multi-provider search tool for KDE
Exec=klookup %u
Icon=org.kde.klookup
Type=Application
Categories=Qt;KDE;Utility;Dictionary;
Terminal=false
StartupNotify=true
DBusActivatable=true
X-DBus-ServiceName=org.kde.klookup

Actions=show_search;search_clipboard;

[Desktop Action show_search]
Name=Show/focus KLookup search
Exec=klookup --show-search
Icon=edit-find

[Desktop Action search_clipboard]
Name=Search clipboard now
Exec=klookup --search-clipboard
Icon=edit-paste
